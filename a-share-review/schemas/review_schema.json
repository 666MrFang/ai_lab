{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a-share-daily-review.schema.json",
  "title": "A-Share Daily Review",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "date",
    "market",
    "market_regime",
    "sectors",
    "stocks",
    "profit_effect",
    "loss_effect",
    "evidence_gaps",
    "tomorrow_watch_conditions",
    "metric_claims",
    "evidence_registry"
  ],

  "properties": {
    "date": {
      "type": "string"
    },

    "market": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "facts",
        "inferences"
      ],

      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },

        "inferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inference"
          }
        }
      }
    },

    "market_regime": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "state",
        "confidence",
        "evidence",
        "counter_evidence",
        "evidence_gaps"
      ],

      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "MAIN_UPTREND",
            "ROTATION",
            "LOSS_EFFECT",
            "ICE_POINT",
            "UNCERTAIN"
          ]
        },

        "confidence": {
          "$ref": "#/$defs/confidence"
        },

        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },

        "counter_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },

        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "sectors": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "top_gainers",
        "top_losers",
        "main_theme_candidates"
      ],

      "properties": {
        "top_gainers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sector"
          }
        },

        "top_losers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sector"
          }
        },

        "main_theme_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/themeCandidate"
          }
        }
      }
    },

    "stocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stockAnalysis"
      }
    },

    "profit_effect": {
      "$ref": "#/$defs/effectAnalysis"
    },

    "loss_effect": {
      "$ref": "#/$defs/effectAnalysis"
    },

    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "tomorrow_watch_conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/watchCondition"
      }
    },

    "metric_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metricClaim"
      }
    },

    "evidence_registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceEntry"
      }
    }
  },

  "$defs": {
    "metricClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "metric",
        "claim_type",
        "current_value",
        "unit",
        "semantic_label",
        "baseline_refs",
        "threshold_policy_ref",
        "evidence_refs",
        "forward_claim",
        "text_ref"
      ],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "claim_type": {
          "type": "string",
          "enum": ["FACT", "RELATIVE_NUMERIC", "SEMANTIC", "FORWARD"]
        },
        "current_value": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"] },
        "semantic_label": { "enum": ["high", "low", "strong", "weak", null] },
        "baseline_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^E[0-9]+$" }
        },
        "threshold_policy_ref": { "type": ["string", "null"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^E[0-9]+$" }
        },
        "forward_claim": { "type": "boolean" },
        "text_ref": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "required": ["claim_type"],
            "properties": { "claim_type": { "const": "SEMANTIC" } }
          },
          "then": {
            "properties": {
              "semantic_label": {
                "type": "string",
                "enum": ["high", "low", "strong", "weak"]
              },
              "baseline_refs": { "type": "array", "minItems": 1 },
              "threshold_policy_ref": { "type": "string", "minLength": 1 }
            }
          },
          "else": {
            "properties": { "semantic_label": { "type": "null" } }
          }
        },
        {
          "if": {
            "required": ["claim_type"],
            "properties": { "claim_type": { "const": "RELATIVE_NUMERIC" } }
          },
          "then": {
            "properties": { "baseline_refs": { "type": "array", "minItems": 1 } }
          }
        },
        {
          "if": {
            "required": ["claim_type"],
            "properties": { "claim_type": { "const": "FORWARD" } }
          },
          "then": {
            "properties": { "forward_claim": { "const": true } }
          },
          "else": {
            "properties": { "forward_claim": { "const": false } }
          }
        }
      ]
    },

    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_type"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^E[0-9]+$" },
        "evidence_type": {
          "type": "string",
          "enum": ["market_metric", "market_metric_baseline"]
        },
        "metric": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"] },
        "window": { "type": ["integer", "null"] },
        "value": { "type": ["number", "null"] },
        "avg": { "type": ["number", "null"] },
        "median": { "type": ["number", "null"] },
        "percentile": { "type": ["number", "null"] },
        "sample_count": { "type": ["integer", "null"] },
        "complete": { "type": ["boolean", "null"] },
        "unit": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },

    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },

    "fact": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "statement",
        "source"
      ],

      "properties": {
        "statement": {
          "type": "string"
        },

        "source": {
          "type": "string"
        }
      }
    },

    "evidence": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "statement",
        "source",
        "strength"
      ],

      "properties": {
        "statement": {
          "type": "string"
        },

        "source": {
          "type": "string"
        },

        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },

        "strength": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        }
      }
    },

    "inference": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "claim",
        "confidence",
        "evidence",
        "counter_evidence",
        "evidence_gaps"
      ],

      "properties": {
        "claim": {
          "type": "string"
        },

        "confidence": {
          "$ref": "#/$defs/confidence"
        },

        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },

        "counter_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },

        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "sector": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "sector_name",
        "change_pct"
      ],

      "properties": {
        "sector_name": {
          "type": "string"
        },

        "change_pct": {
          "type": "number"
        },

        "turnover_cny": {
          "type": [
            "number",
            "null"
          ]
        },

        "change_5d_pct": {
          "type": [
            "number",
            "null"
          ]
        },

        "change_20d_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },

    "themeCandidate": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "sector_name",
        "confidence",
        "evidence",
        "evidence_gaps"
      ],

      "properties": {
        "sector_name": {
          "type": "string"
        },

        "confidence": {
          "$ref": "#/$defs/confidence"
        },

        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },

        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "stockAnalysis": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "code",
        "name",
        "sector_name",
        "roles",
        "facts",
        "possible_drivers",
        "historical_behavior",
        "evidence_gaps"
      ],

      "properties": {
        "code": {
          "type": "string"
        },

        "name": {
          "type": "string"
        },

        "sector_name": {
          "type": "string"
        },

        "roles": {
          "type": "array",

          "items": {
            "type": "string",
            "enum": [
              "STRONG_STOCK",
              "CAPACITY_CORE_CANDIDATE",
              "POPULARITY_STOCK",
              "OTHER"
            ]
          }
        },

        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },

        "possible_drivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inference"
          }
        },

        "historical_behavior": {
          "oneOf": [
            {
              "$ref": "#/$defs/historicalBehavior"
            },
            {
              "type": "null"
            }
          ]
        },

        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "historicalBehavior": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "event_definition",
        "sample_size",
        "statistics",
        "confidence"
      ],

      "properties": {
        "event_definition": {
          "type": "string"
        },

        "sample_size": {
          "type": "integer",
          "minimum": 0
        },

        "statistics": {
          "type": "object"
        },

        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },

    "effectAnalysis": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "summary",
        "confidence",
        "evidence",
        "evidence_gaps"
      ],

      "properties": {
        "summary": {
          "type": "string"
        },

        "confidence": {
          "$ref": "#/$defs/confidence"
        },

        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },

        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "watchCondition": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "target",
        "condition",
        "meaning"
      ],

      "properties": {
        "target": {
          "type": "string"
        },

        "condition": {
          "type": "string"
        },

        "meaning": {
          "type": "string"
        },
        "condition_id": { "type": ["string", "null"] },
        "metric": { "type": ["string", "null"] },
        "operator": {
          "enum": ["gt", "gte", "lt", "lte", "eq", null]
        },
        "expected_value": { "type": ["number", "null"] },
        "horizon_sessions": { "type": ["integer", "null"], "minimum": 1 },
        "evidence_ref": { "type": ["string", "null"] }
      }
    }
  }
}